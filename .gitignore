api_key

# === project-specific ===
# `assets/` is a symlink to /mnt/d/theres_is_no_homeless/ — heavy raw media,
# off-the-record footage, NOT for public repo. Stays local.
/assets

# Word-level transcripts of phone footage may contain personally identifiable
# information (real names, conversations not yet redacted for publication).
# Excluded by default; review per-file before adding back.
/transcriptions_word_level/

